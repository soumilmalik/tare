# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (server only — reminders and the admin usage view). Never share it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional overrides
AI_MODEL_PHOTO=claude-sonnet-5-5
AI_MODEL_TEXT=claude-haiku-4-5
AI_DAILY_LIMIT_PER_USER=40
# Cost tracking: USD per 1M tokens, and the USD→INR rate
AI_PRICE_PHOTO_INPUT_PER_M_USD=2
AI_PRICE_PHOTO_OUTPUT_PER_M_USD=10
AI_PRICE_TEXT_INPUT_PER_M_USD=1
AI_PRICE_TEXT_OUTPUT_PER_M_USD=5
USD_TO_INR=95

# ElevenLabs (voice → text). elevenlabs.io → Developers → API Keys
ELEVENLABS_API_KEY=xxx

# Your email: unlocks the "Usage and cost" view in Profile
ADMIN_EMAIL=you@gmail.com

# Web Push. Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxx
VAPID_PRIVATE_KEY=xxx
VAPID_SUBJECT=mailto:you@gmail.com
# Any long random string; also pasted into supabase/migrations/0004_reminders_cron.sql
CRON_SECRET=xxx
